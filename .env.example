# Application
APP_NAME="Revelio AI Backend"
ENVIRONMENT=development

# Database (PostgreSQL, via Docker Compose — ver docker/docker-compose.yml)
DATABASE_URL=postgresql+psycopg://revelio:revelio@localhost:5432/revelio

# Ollama / VLM — roda no PC GPU, acessível apenas via Tailscale (ver docs/infrastructure-security.md).
# Nunca aponte para um IP público nem exponha o Ollama diretamente à Internet.
# OLLAMA_ENABLED=false desliga o Ollama do pipeline por completo (ex.: GPU
# indisponível) — a aplicação passa a usar só o Gemini Flash-Lite abaixo.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://100.118.123.0:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_MAX_RETRIES=2
OLLAMA_NUM_CTX=8192

# Gemini Flash-Lite — único fallback quando o Ollama está desabilitado ou
# indisponível (ETAPA 13.1). GEMINI_ENABLED=false só é válido se o Ollama
# estiver habilitado (senão não sobra nenhum provider de VLM).
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_SECONDS=30

# Otimização da imagem antes de enviar à VLM (não altera a imagem persistida)
IMAGE_MAX_DIMENSION=768
IMAGE_JPEG_QUALITY=85
IMAGE_ENABLE_OPTIMIZATION=true

# Teste de integração opcional contra o Ollama real (ver
# backend/tests/infrastructure/vlm/test_ollama_vision_language_model_integration.py).
# Os testes normais (pytest padrão) NÃO dependem da GPU nem do Ollama.
OLLAMA_INTEGRATION_TEST=false

# Raiz dos prompts versionados enviados à VLM (ver prompts/system, prompts/scene, prompts/question)
PROMPTS_ROOT=prompts

# PC GPU — infraestrutura (Tailscale + SSH), ver docs/infrastructure-security.md
GPU_HOST=100.118.123.0
GPU_USER=pazol
OLLAMA_PORT=11434

# Armazenamento local de imagens (mesma máquina da GPU)
IMAGE_STORAGE_PATH=data/images
MAX_IMAGE_SIZE_BYTES=10485760

# Detector YOLO (COCO, 80 classes)
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
